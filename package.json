{
  "name": "commercia",
  "version": "0.1.0",
  "private": true,
  "description": "Stock, billing, GST and khata for one kirana shop",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c teal,yellow \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "npm run build && tsx server/index.ts",
    "serve": "tsx server/index.ts",
    "seed:demo": "tsx server/scripts/seed-demo.ts",
    "backup": "tsx server/scripts/backup.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "better-sqlite3": "^13.0.3",
    "exceljs": "^4.4.0",
    "hono": "^4.13.13",
    "kysely": "^0.29.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "lucide-react": "^1.56.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
