# Copy this file to ".env" (next to package.json) to change a setting. Everything is optional:
# Commercia runs with none of it. Never put real values in this example file, and never commit ".env".
# Settings already in the environment win over this file.

# --- Where it listens -------------------------------------------------------------------------------
# PORT=8787
# 0.0.0.0 lets phones on the shop Wi-Fi reach the laptop. Use 127.0.0.1 to keep it to this computer only.
# HOST=0.0.0.0

# --- Data -------------------------------------------------------------------------------------------
# COMMERCIA_DB=data/commercia.db
# After go-live on Postgres/Supabase (needs ?sslmode=require when the database is not on this computer):
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# --- The secret key (locks backups and authenticator secrets) ---------------------------------------
# 64 hex characters. If you do not set one, Commercia makes one and keeps it in data/commercia.key.
# KEEP A COPY OF THE KEY SOMEWHERE SAFE, NOT IN THE BACKUP FOLDER: without it, backups cannot be opened.
# `npm run init-env` creates a .env with a fresh random key.
# COMMERCIA_SECRET_KEY=
# When changing the key, put the old one here until `npm run rotate-key` has run (comma separated).
# COMMERCIA_SECRET_KEY_PREVIOUS=
# COMMERCIA_KEY_FILE=data/commercia.key

# --- Email (optional: sign-in verification codes, password-reset codes and security alerts) ---------
# The easy way: fill these four in, then run `npm run test-mail -- you@example.com`. See docs/EMAIL.md for Gmail steps.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=yourshop@gmail.com
# SMTP_PASSWORD=
# MAIL_FROM=Sharma Kirana <yourshop@gmail.com>
# Or, instead of the four lines above, one address (a @ in the user name must be written %40):
# SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465

# --- Behind a tunnel or reverse proxy ---------------------------------------------------------------
# 1 = a proxy on this same computer (Cloudflare Tunnel, Tailscale Serve): its forwarding headers are believed.
# TRUST_PROXY=0
# Other proxy addresses whose forwarding headers may be believed (comma separated).
# TRUSTED_PROXIES=
# Extra web addresses allowed to send changes to the app (the address you open it on is always allowed).
# ALLOWED_ORIGINS=https://shop.example.com

# --- Who may connect --------------------------------------------------------------------------------
# Networks allowed to reach the app (comma separated). Default: this computer, private networks and Tailscale.
# ALLOWED_IPS=
# 1 = phones on the shop Wi-Fi still see the list of names to tap at login (otherwise they type an email).
# SHOW_USERS_ON_LAN=0

# --- Passwords --------------------------------------------------------------------------------------
# Cost of password hashing as a power of two (12 to 20). Higher is slower for an attacker, and for you.
# COMMERCIA_SCRYPT_LOG2=17
